# Sao chép thành backend/.env (không commit file .env)
# Tạo khoá ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=3600
# Chỉ đặt =development khi chạy local (cho phép khoá dev nếu thiếu SECRET_KEY)
SLOPEE_ENV=development
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=slopee_db
# P0-05: khóa tạm khi nhập sai mật khẩu/PIN liên tiếp (mặc định 5 lần, khóa 900 giây)
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=900

# --- Web3 (tuần 3) ---
# RPC_URL, ESCROW_ADDRESS, MOCKUSD_ADDRESS và các khóa vai trò do scripts/bootstrap.sh sinh vào backend/.env.web3 (KHÔNG commit);
# app tự đọc file đó. Chỉ khi cần ghi đè mới đặt ở đây:
# WALLET_LINK_DOMAIN=localhost:5173   # tên miền trong thông điệp ký liên kết ví (origin của frontend)
# WALLET_NONCE_MAX_PER_MINUTE=5

# --- Truy cập từ máy khác trong LAN/VPN ---
# Không cần đổi gì ở backend: Vite proxy /api và /rpc, backend/Anvil/MySQL giữ nghe 127.0.0.1 (xem INSTALL.md).
# CORS_ORIGINS=https://host:5173      # chỉ khi gọi API TRỰC TIẾP từ origin khác (mặc định: localhost/127.0.0.1:5173)
# WALLET_LINK_DOMAIN=host:5173        # chỉ là chuỗi hiển thị trong thông điệp ký (server không đối chiếu origin)
