# Sao chép thành backend/.env (không commit file .env)
# Tạo khoá ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=3600
# Chỉ đặt =development khi chạy local (cho phép khoá dev nếu thiếu SECRET_KEY)
SLOPEE_ENV=development
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=slopee_db
# P0-05: khóa tạm khi nhập sai mật khẩu/PIN liên tiếp (mặc định 5 lần, khóa 900 giây)
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
